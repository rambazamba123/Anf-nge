function ttsPump(){
  if (TTS.active) return;
  const next = TTS.q.shift();
  if (next === undefined){
    setTalkState('');
    if (TTS.final && TTS.onEnd){ const f = TTS.onEnd; TTS.onEnd = null; f(); }
    return;
  }
  TTS.active = true; setTalkState('speak');
  const g = TTS.gen, u = utter(next);
  const done = () => { if (g !== TTS.gen || !TTS.active) return; clearTimeout(TTS.dog); TTS.active = false; ttsPump(); };
  u.onend = done; u.onerror = done;
