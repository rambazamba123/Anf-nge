const TTS = {q:[], active:false, gen:0, final:true, onEnd:null, dog:null};
function utter(text, o={}){
  const u = new SpeechSynthesisUtterance(text);
  u.lang = 'de-DE'; u.rate = o.rate || 1.03; if (o.pitch) u.pitch = o.pitch;
  const v = o.voice || voices.find(v => /Google|Anna|Petra|Helena|Katja/i.test(v.name)) || voices[0];
