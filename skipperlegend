function runQuiz(queue, title, examMode=false){
  stopSpeak();
  let i = 0, right = 0; const wrong = [], requeued = new Set();
  queue = queue.slice();
  const total0 = queue.length;
  function show(){
    if (i >= queue.length) return finish();
    const q = queue[i], order = shuffle([0,1,2,3]);
    const t = topicOf(q.n);
    app.innerHTML = `
      <div class="qhead"><div><div class="tag">${esc(title)} · ${t.name}</div></div><button class="btn ghost small" id="quit" style="min-height:40px;padding:.4em .9em">Beenden</button></div>
      <div class="prog"><i style="width:${(i/queue.length*100).toFixed(0)}%"></i></div>
      <div class="tag">Frage ${q.n}${st(q.n) || examMode ? '' : ' · neu'}</div>
      <div class="qtext">${esc(q.q)}</div>
      ${q.sig ? `<div class="sig" aria-label="Signal">${esc(q.sig)}</div>` : ''}
      ${q.img ? `<div class="qimg">${q.img.map(s => `<img src="${s}" alt="Abbildung zu Frage ${q.n}">`).join('')}</div>` : ''}
      <div id="ans">${order.map(k => `<button class="ans" data-k="${k}">${esc(q.a[k])}</button>`).join('')}</div>
      <div id="after"></div>`;
    $('#quit').onclick = () => examMode ? finish(true) : (save(), setTab('home'));
    app.querySelectorAll('.ans').forEach(b => b.onclick = () => answer(q, +b.dataset.k));
  }
  function answer(q, k){
    const ok = k === 0, retry = requeued.has(q.n);
    app.querySelectorAll('.ans').forEach(b => { b.disabled = true; const kk = +b.dataset.k; if (!examMode){ if (kk === 0) b.classList.add('ok'); else if (kk === k) b.classList.add('no'); } else if (kk === k) b.setAttribute('aria-pressed','true'); });
    if (ok && !retry) right++; if (!ok) wrong.push({q, k});
    if (!examMode){
      if (!retry) record(q.n, ok);
      if (!ok && !retry) { requeued.add(q.n); queue.push(q); }
    }
    if (examMode){ i++; return show(); }
    const af = $('#after');
    af.innerHTML = `<div class="fb">${ok ? '<strong style="color:var(--stb)">Richtig.</strong>' : '<strong style="color:var(--bb)">Nicht ganz.</strong> Grün markiert ist die Katalogantwort. Die Frage kommt am Ende noch einmal.'}
      <div id="expl" class="lesson" style="margin-top:8px"></div>
      <div class="row" style="margin-top:10px"><button class="btn ghost" id="why">${ok ? 'Warum ist das so?' : 'Erklär es mir'}</button><button class="btn" id="nxt">Weiter</button></div></div>`;
    $('#nxt').onclick = () => { stopSpeak(); i++; show(); };
    $('#nxt').focus();
    $('#why').onclick = () => explain(q, k);
  }
  function explain(q, k){
    const ex = $('#expl'); $('#why').disabled = true;
    ex.innerHTML = '<p class="think">Skipper überlegt…</p>';
    const prompt = persona() + `\n\nKatalogfrage ${q.n}: ${q.q}${q.sig ? ' ['+q.sig+']' : ''}${q.img ? ' (zur Frage gehört eine Abbildung, die du nicht siehst)' : ''}\nRichtige Katalogantwort: ${q.a[0]}\n${k !== 0 ? 'Der Lernende wählte: ' + q.a[k] + '\n' : ''}Erkläre in 2–4 Sätzen, warum die Katalogantwort stimmt${k!==0?' und was an der gewählten Antwort falsch ist':''}. Gib eine kurze Merkhilfe, wenn sie wirklich hilft.`;
    ai(prompt, {modelTier:'quick', onText:({text}) => { ex.innerHTML = md(text); }})
      .then(({text}) => { ex.innerHTML = md(text); if ('speechSynthesis' in window){ const b = document.createElement('button'); b.className='btn ghost small'; b.style.marginTop='6px'; b.textContent='Vorlesen'; b.onclick=()=>speak(text); ex.appendChild(b);} })
      .catch(e => { ex.innerHTML = `<p class="muted">${esc(aiErr(e))}</p>`; $('#why').disabled = false; });
  }
  function finish(aborted){
    stopSpeak();
    const n = examMode ? total0 : total0;
    const score = examMode ? right : Math.min(right, total0);
    app.innerHTML = `<h1>${examMode ? 'Probeprüfung ausgewertet' : 'Gut gemacht.'}</h1>
      <div class="card"><div class="big" style="font-family:var(--hfont);font-size:2.4rem;font-weight:700">${score} von ${examMode ? n : total0}</div>
      <p class="muted">${examMode ? 'richtig beantwortet. Die genaue Bestehensgrenze prüfst du am besten in den offiziellen Prüfungsregeln nach.' : 'Fragen beim ersten Versuch richtig. Falsch beantwortete Fragen kommen in den nächsten Tagen öfter dran.'}</p></div>
      ${examMode && wrong.length ? `<h2>Das solltest du dir noch einmal ansehen</h2>${wrong.map(w => `<div class="card"><div class="tag">Frage ${w.q.n}</div><p><strong>${esc(w.q.q)}</strong></p>${w.q.img ? `<div class="qimg">${w.q.img.map(s=>`<img src="${s}" alt="">`).join('')}</div>` : ''}<p style="color:var(--bb)">Deine Antwort: ${esc(w.q.a[w.k])}</p><p style="color:var(--stb)">Richtig: ${esc(w.q.a[0])}</p></div>`).join('')}` : ''}
      <button class="btn wide" id="home">Zurück zur Übersicht</button>`;
    if (examMode){ wrong.forEach(w => { const s = st(w.q.n); if (s){ s.b = 1; s.w++; } }); S.exams = (S.exams||[]).concat({day:today(), score:right, n}); save(); }
    $('#home').onclick = () => setTab('home');
  }
  show();
}
