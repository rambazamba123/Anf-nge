async function makeStory(t){
  const box = $('#story'); $('#gen').disabled = true;
  box.innerHTML = '<p class="think">Die drei setzen sich an den Tisch und schenken Tee ein…</p>';
  const pool = Q.filter(q => q.n >= t.from && q.n <= t.to);
  const known = shuffle(pool.filter(q => st(q.n))), fresh = shuffle(pool.filter(q => !st(q.n)));
  const pick = [...known.slice(0,4), ...fresh].slice(0,5).sort((a,b)=>a.n-b.n);
  const prompt = persona(`Katalogfragen mit verbindlicher richtiger Antwort:\n${pick.map(catLine).join('\n')}`) + `

Schreibe ein unterhaltsames Hörspiel-Gespräch in der Kajüte einer Segelyacht zwischen drei Figuren:
H = Hinnerk, alter Fischer aus Büsum, trocken-humorvoll, plattdeutsche Einsprengsel sparsam.
I = Ilka, Kapitänin, präzise, warmherzig, korrigiert gern.
J = Jonas, junger Segellehrer, neugierig, stellt den anderen Fangfragen.
Thema: „${t.name}“. Erzählt euch kleine, ausgedachte Erlebnisse, in denen das Wissen aus ALLEN oben genannten Katalogfragen vorkommt und richtig erklärt wird. Die Fachinhalte müssen exakt zum Katalog passen; erfinde keine Regeln. Kein Erzähler, nur wörtliche Rede, kurze Sätze, gut vorlesbar, 16 bis 22 Beiträge.
Antworte NUR mit JSON in dieser Form: {"title":"kurzer Titel","lines":[{"s":"H","t":"..."},{"s":"J","t":"..."}]}`;
  try{
    const data = await aiJson(prompt, {modelTier:'complex', maxTokens:4000});
    if (!data || !Array.isArray(data.lines) || !data.lines.length) throw {code:'invalid_json'};
    const story = {title: String(data.title || t.name), topic: t.id, qs: pick.map(q => q.n), lines: data.lines.filter(l => CAST[l.s] && l.t).map(l => ({s:l.s, t:String(l.t)}))};
    S.stories = (S.stories || []).concat(story).slice(-5); save();
    showStory(story);
  }catch(e){
    box.innerHTML = `<p class="muted">${esc(e.code === 'invalid_json' ? 'Die Geschichte kam unvollständig an. Versuch es noch einmal.' : aiErr(e))}</p>`;
  }
  const g = $('#gen'); if (g) g.disabled = false;
}
function showStory(story){
  const box = $('#story');
  box.innerHTML = `<h2>${esc(story.title)}</h2>
    <div class="row" style="margin-bottom:14px"><button class="btn" id="play">Vorlesen</button><button class="btn ghost" id="pq">Fragen dazu üben</button></div>
    <div id="lines">${story.lines.map((l,i) => `<div class="line" data-i="${i}"><span class="who" style="color:${CAST[l.s].color}">${CAST[l.s].name}</span><span>${esc(l.t)}</span></div>`).join('')}</div>`;
  $('#pq').onclick = () => { stopSpeak(); runQuiz(story.qs.map(n => QN[n]).filter(q => !q.skip), 'Fragen aus der Kajüte'); };
  const btn = $('#play');
  btn.onclick = () => {
    if (cabinPlay) { cabinPlay = null; stopSpeak(); btn.textContent = 'Vorlesen'; document.querySelectorAll('.line').forEach(x => x.classList.remove('now')); return; }
    if (!('speechSynthesis' in window)) { btn.textContent = 'Vorlesen nicht verfügbar'; btn.disabled = true; return; }
    const token = cabinPlay = {}; btn.textContent = 'Anhalten';
    const vs = voices.length ? voices : [];
    const step = i => {
      if (cabinPlay !== token) return;
      document.querySelectorAll('.line').forEach(x => x.classList.toggle('now', +x.dataset.i === i));
      if (i >= story.lines.length) { cabinPlay = null; btn.textContent = 'Nochmal vorlesen'; return; }
      const l = story.lines[i], c = CAST[l.s];
      const el = document.querySelector(`.line[data-i="${i}"]`); if (el) el.scrollIntoView({block:'center', behavior:'smooth'});
      const u = new SpeechSynthesisUtterance(l.t); u.lang = 'de-DE'; u.pitch = c.pitch; u.rate = c.rate;
      if (vs.length) u.voice = vs[{H:0, I:1, J:2}[l.s] % vs.length];
      let moved = false; const go = () => { if (moved) return; moved = true; clearTimeout(dog); if (cabinPlay === token) setTimeout(() => step(i + 1), 250); };
      const dog = setTimeout(go, 4000 + l.t.length * 120); // falls Android das Ende nicht meldet
      u.onend = go; u.onerror = go;
      speechSynthesis.speak(u);
    };
    speechSynthesis.cancel(); setTimeout(() => step(0), 120);
  };
}

