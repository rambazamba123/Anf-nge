let ctl = null, busy = false, rec = null, listening = false;
function relevant(text){
  const words = text.toLowerCase().match(/[a-zäöüß]{4,}/g) || [];
  if (!words.length) return [];
  return Q.map(q => { const h = (q.q + ' ' + q.a[0]).toLowerCase(); return {q, s: words.reduce((a,w) => a + (h.includes(w) ? 1 : 0), 0)}; })
    .filter(x => x.s > 0).sort((a,b) => b.s - a.s).slice(0, 12).map(x => x.q);
}
function renderChat(){
  app.innerHTML = `<h1>Dein Skipper</h1>
    <p class="muted small">Stell Fragen per Text oder Sprache. Im Gespräch spricht der Skipper mit dir und hört danach automatisch wieder zu.</p>
    <label class="toggle"><input type="checkbox" id="rd" ${S.read?'checked':''}> Antworten automatisch vorlesen</label>
    ${apiKey() ? '' : keyCardHtml('ck')}
    ${SR ? `<button class="btn wide talkbtn" id="talkGo">${S.talk ? 'Gespräch beenden' : '🎙️ Gespräch mit dem Skipper starten'}</button>` : '<p class="small muted">Dieser Browser kann keine Sprache erkennen. Nutze Chrome.</p>'}
    <div class="talkstate hidden" id="talkState" role="status" aria-live="polite"></div>
    <div class="chat" id="log"></div><div style="height:90px"></div>`;
  if (!apiKey()) bindKeyCard('ck', renderChat);
  const tg = $('#talkGo'); if (tg) tg.onclick = () => {
    if (S.talk){ S.talk = false; save(); stopListen(); stopSpeak(); renderChat(); return; }
    if (!apiKey()){ addMsg('assistant', aiErr({code:'no_key'})); return; }
    S.talk = true; S.read = true; save(); renderChat();
    // Stimme mit dem Tipp freischalten (Chrome verlangt eine Berührung)
    try{ speechSynthesis.cancel(); speechSynthesis.speak(Object.assign(new SpeechSynthesisUtterance(' '), {volume:0})); }catch(e){}
    startListen();
  };
  const tsEl = $('#talkState'); tsEl.onclick = () => { if (tsEl.dataset.st === 'speak'){ stopSpeak(); if (S.talk) startListen(); } };
  setTalkState('');
  const log = $('#log');
  if (!S.chat.length) log.innerHTML = `<div class="msg a"><p>Frag mich alles rund um den SBF See, zum Beispiel: „Wie erkenne ich nachts ein Segelboot?“ oder „Erklär mir die Ausweichregeln“.</p></div>`;
  S.chat.forEach(m => addMsg(m.role, m.content));
  const rd = $('#rd'); rd.onchange = () => { S.read = rd.checked; save(); };
  const t = $('#talk'); if (t) t.onchange = () => { S.talk = t.checked; save(); if (S.talk){ S.read = true; rd.checked = true; save(); startListen(); } else stopListen(); };
  $('#micBtn').classList.toggle('hidden', !SR);
  window.scrollTo(0, document.body.scrollHeight);
}
function addMsg(role, text){
  const log = $('#log'); if (!log) return null;
  const d = document.createElement('div'); d.className = 'msg ' + (role === 'user' ? 'u' : 'a');
  d.innerHTML = role === 'user' ? `<p>${esc(text)}</p>` : md(text);
  if (role !== 'user' && 'speechSynthesis' in window){ const b = document.createElement('button'); b.className='sp'; b.textContent='Vorlesen'; b.onclick=()=>speak(text); d.appendChild(b); }
  log.appendChild(d); return d;
}
async function send(text){
  text = (text || '').trim(); if (!text || busy) return;
  busy = true; $('#sendBtn').disabled = true; stopListen(); stopSpeak();
  $('#chatIn').value = '';
  S.chat.push({role:'user', content:text}); addMsg('user', text);
  const bubble = addMsg('assistant', ''); bubble.innerHTML = '<p class="think">Skipper überlegt…</p>';
  const voice = (S.read || S.talk) && ('speechSynthesis' in window);
  let spokenUpTo = 0;
  if (voice){ TTS.gen++; TTS.q = []; TTS.active = false; TTS.final = false; TTS.onEnd = () => { if (S.talk && tab === 'chat') startListen(); }; }
  setTalkState('think');
  const feedVoice = (full, last) => {
    if (!voice) return;
    const rest = full.slice(spokenUpTo);
    let cut = last ? rest.length : -1;
    if (!last){ const m = [...rest.matchAll(/[.!?…:](\s|$)|\n/g)]; if (m.length){ const x = m[m.length-1]; cut = x.index + x[0].length; } }
    if (cut > 0){ ttsAdd(rest.slice(0, cut)); spokenUpTo += cut; }
  };
  window.scrollTo(0, document.body.scrollHeight);
  const rel = relevant(text);
  const rules = persona(rel.length ? `Passende Katalogfragen mit verbindlicher richtiger Antwort:\n${rel.map(catLine).join('\n')}` : '') + (S.talk ? '\nWir führen ein gesprochenes Gespräch: Antworte in 2–4 kurzen, natürlich gesprochenen Sätzen, ohne Aufzählungen, Sternchen oder Abkürzungen, die man schlecht vorlesen kann. Stell am Ende meist eine kurze Rückfrage oder eine kleine Prüfungsfrage, damit das Gespräch weitergeht.' : '\nAntworte meist in 2–5 Sätzen. Frag am Ende ab und zu kurz zurück, um das Verständnis zu prüfen.');
  const hist = S.chat.slice(-12).filter((m,i,a) => !(i===0 && m.role==='assistant'));
  ctl = new AbortController();
  try{
    const {text: ans} = await ai([{role:'user', content:rules}, ...hist], {maxTokens: S.talk ? 600 : 1200, signal:ctl.signal, onText:({text}) => { bubble.innerHTML = md(text); feedVoice(text, false); }});
    bubble.innerHTML = md(ans);
    const b = document.createElement('button'); b.className='sp'; b.textContent='Vorlesen'; b.onclick=()=>speak(ans); bubble.appendChild(b);
    S.chat.push({role:'assistant', content:ans}); S.chat = S.chat.slice(-40); save();
    if (voice){ feedVoice(ans, true); TTS.final = true; ttsPump(); } else setTalkState('');
  }catch(e){
    S.chat.pop(); stopSpeak();
    bubble.innerHTML = `<p class="muted">${esc(aiErr(e) || 'Abgebrochen.')}</p>`;
  }
  busy = false; $('#sendBtn').disabled = false;
  window.scrollTo(0, document.body.scrollHeight);
}
let micOk = null;
async function checkMic(){ return !!SR; }
function micFail(code){
  listening = false; const m = $('#micBtn'); if (m) m.classList.remove('on');
  S.talk = false; save(); const t = $('#talk'); if (t) t.checked = false; setTalkState('');
  const why = (code === 'not-allowed' || code === 'service-not-allowed')
    ? 'Chrome darf das Mikrofon nicht nutzen. Tippe oben links in der Adresszeile auf das Schloss-Symbol → Berechtigungen → Mikrofon erlauben, dann Seite neu laden.'
    : code === 'network' ? 'Die Spracherkennung braucht eine Internetverbindung.'
    : code === 'audio-capture' ? 'Kein Mikrofon gefunden oder gerade von einer anderen App belegt.'
    : `Die Spracherkennung hat nicht geklappt (Fehler: ${code}).`;
  addMsg('assistant', why);
}
async function startListen(){
  if (!SR || listening || busy) return;
  stopSpeak();
  if (!(await checkMic())) return;
  rec = new SR(); rec.lang = 'de-DE'; rec.interimResults = true; rec.continuous = false; setTalkState('listen');
  let finalText = '', heard = false, err = null;
  rec.onresult = ev => { heard = true; let s = ''; for (const r of ev.results){ s += r[0].transcript; if (r.isFinal) finalText = s; } $('#chatIn').value = s; };
  rec.onerror = ev => { err = ev.error; };
  rec.onend = () => {
    listening = false; $('#micBtn').classList.remove('on');
    const said = (finalText || $('#chatIn').value || '').trim();
    if (said && heard) return send(said);
    setTalkState('');
    if (err && err !== 'no-speech' && err !== 'aborted') micFail(err);
  };
  try { rec.start(); listening = true; $('#micBtn').classList.add('on'); $('#micBtn').setAttribute('aria-label','Zuhören beenden'); } catch(e){ micFail(e.name || 'start'); }
}
function stopListen(){ if (rec && listening){ try{ rec.abort(); }catch(e){} } listening = false; if (document.getElementById('talkState') && document.getElementById('talkState').dataset.st === 'listen') setTalkState(''); const m = $('#micBtn'); if (m){ m.classList.remove('on'); m.setAttribute('aria-label','Spracheingabe starten'); } }
$('#micBtn').onclick = () => listening ? stopListen() : startListen();
$('#sendBtn').onclick = () => send($('#chatIn').value);
$('#chatIn').addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); send($('#chatIn').value); } });

/* ---------- Start ---------- */
app.innerHTML = '<p class="muted">Kurs wird geladen…</p>';
initSync().finally(() => {
  if (!S.profile) renderOnboarding();
  else { $('#tabs').classList.remove('hidden'); setTab('home'); }
});
</script>
