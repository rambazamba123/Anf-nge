let S = load();
function load(){ try{ const v = JSON.parse(localStorage.getItem(KEY)); if(v && v.profile) return v; }catch(e){} return {profile:null,qs:{},lessons:{},chat:[],plan:null,tts:true,talk:false}; }
function save(){ S.updatedAt = Date.now(); try{ localStorage.setItem(KEY, JSON.stringify(S)); }catch(e){} schedulePush(); }

/* ---------- Synchronisation mit der Artefakt-Datenbank ----------
   Lernstand liegt in data/users/<id>/state. Claude kann ihn im Chat lesen
   und Ergebnisse aus Sprachgesprächen eintragen. */
const SYNC = ['profile','qs','plan','exams','start','updatedAt'];
let dbRef = null, pushTimer = null, pushing = false, pushAgain = false;
async function initSync(){
  try{
    return; // Eigenständige Version: Lernstand bleibt im Browser
    const [db, user] = await Promise.all([window.claude.use('db'), window.claude.use('user')]);
    if (!db || !user) return;
    const uid = await user.id(); if (!uid) return;
    dbRef = db.doc('data/users/' + uid + '/state');
    await pull();
  }catch(e){ dbRef = null; }
}
async function pull(){
  if (!dbRef) return false;
  try{
    const snap = await dbRef.get();
    if (!snap.exists){ if (S.profile) schedulePush(0); return false; }
    const r = snap.data();
    if (r && r.profile && (!S.profile || (r.updatedAt || 0) >= (S.updatedAt || 0))){
      SYNC.forEach(k => { if (r[k] !== undefined) S[k] = r[k]; });
      try{ localStorage.setItem(KEY, JSON.stringify(S)); }catch(e){}
      return true;
    } else if (S.profile) schedulePush(0);
  }catch(e){}
  return false;
}
function schedulePush(ms=1500){ if (!dbRef) return; clearTimeout(pushTimer); pushTimer = setTimeout(push, ms); }
async function push(){
  if (!dbRef || !S.profile) return;
  if (pushing){ pushAgain = true; return; }
  pushing = true;
  const body = {}; SYNC.forEach(k => { if (S[k] !== undefined) body[k] = S[k]; });
  try{ await dbRef.set(JSON.parse(JSON.stringify(body))); }catch(e){ if (e && e.code === 'invalid_argument') dbRef = null; }
  pushing = false;
  if (pushAgain){ pushAgain = false; push(); }
}
document.addEventListener('visibilitychange', async () => {
  if (document.visibilityState === 'visible' && dbRef && await pull()){
    if (!S.profile) return;
    if (tab === 'home' && document.querySelector('.scene')) renderHome();
    else if (tab === 'progress') renderProgress();
  }
});

/* ---------- Datum ---------- */
const dayNum = d => Math.floor((Date.UTC(d.getFullYear(), d.getMonth(), d.getDate())) / 864e5);
const today = () => dayNum(new Date());
function examDay(){ const [y,m,d] = S.profile.exam.split('-').map(Number); return dayNum(new Date(y, m-1, d)); }
const daysLeft = () => Math.max(0, examDay() - today());

/* ---------- Lernlogik ---------- */
const st = n => S.qs[n] || null;
const isDue = n => { const s = st(n); return s && s.b < 5 && s.d + INT[s.b] <= today(); };
const unseen = () => Q.filter(q => !st(q.n));
function computePlan(){
  const t = today();
  if (S.plan && S.plan.day === t) return S.plan;
  const left = Math.max(1, daysLeft());
  const reviewDays = left >= 8 ? Math.round(left * 0.2) : Math.floor(left / 4);
  const learnLeft = Math.max(1, left - reviewDays);
  const u = unseen().length;
  const cap = Math.max(10, Math.round(S.profile.minutes * 2));
  const newTarget = u ? Math.ceil(u / learnLeft) : 0;
  S.plan = {day:t, newTarget, newDone:0, revDone:0, cap};
  save(); return S.plan;
}
function todayNumbers(){
  const p = computePlan();
  const due = Q.filter(q => isDue(q.n)).length;
  const newLeft = Math.max(0, Math.min(p.newTarget - p.newDone, unseen().length));
  return {p, due, newLeft, tight: p.newTarget + due > p.cap * 1.15};
}
function record(n, ok){
  const s = st(n) || {b:0,d:today(),w:0,c:0};
  const wasNew = !st(n);
  s.b = ok ? Math.min(5, s.b + 1) : 1;
  if(!ok) s.w++; else s.c++;
  s.d = today();
  S.qs[n] = s;
  const p = computePlan();
  if (wasNew) p.newDone++; else p.revDone++;
  save();
}
function topicStats(t){
  const list = Q.filter(q => q.n >= t.from && q.n <= t.to);
  let m=0,l=0; list.forEach(q => { const s = st(q.n); if(s){ if(s.b>=3) m++; else l++; } });
  return {total:list.length, m, l};
}
function weakTopics(){
  return TOPICS.map(t => { const list = Q.filter(q=>q.n>=t.from&&q.n<=t.to&&st(q.n)); const w = list.reduce((a,q)=>a+st(q.n).w,0); return {t, r: list.length ? w/list.length : 0}; })
    .filter(x => x.r > 0.3).sort((a,b)=>b.r-a.r).slice(0,3).map(x=>x.t.name);
}
const PROB = [0.25,0.5,0.7,0.85,0.92,0.97]; // geschätzte Trefferwahrscheinlichkeit je Lernstufe
function passChance(){
  const pass = (S.profile && S.profile.pass) || 24, n = 30;
  const p = Q.reduce((a,q) => a + (st(q.n) ? PROB[st(q.n).b] : PROB[0]), 0) / Q.length;
  let c = 1, tail = 0; // Binomialverteilung: P(mindestens pass von n richtig)
  for (let k = 0; k <= n; k++){ if (k > 0) c = c * (n - k + 1) / k; if (k >= pass) tail += c * Math.pow(p,k) * Math.pow(1-p,n-k); }
  return Math.min(1, tail);
}
const shuffle = a => { a = a.slice(); for(let i=a.length-1;i>0;i--){ const j = Math.random()*(i+1)|0; [a[i],a[j]]=[a[j],a[i]]; } return a; };

