<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Skipper – SBF See Lernbegleiter</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@500;600;700&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#E8F0F3; --surface:#FFFFFF; --ink:#0F2D45; --muted:#557085; --line:#C9D7DF;
  --stb:#1E7F4F; --stb-soft:#DCEFE4; --bb:#B8342A; --bb-soft:#F6DEDB; --buoy:#E9B200; --sea:#0F2D45; --on-sea:#F3F7F9;
  --hfont:"Barlow Semi Condensed","Arial Narrow",Arial,sans-serif; --bfont:"Source Sans 3","Segoe UI",Roboto,Arial,sans-serif;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0B1E2E; --surface:#12293C; --ink:#E3EDF2; --muted:#8FA7B8; --line:#24425A;
  --stb:#3FB37A; --stb-soft:#173A2B; --bb:#E0675C; --bb-soft:#3D1F1D; --sea:#081622; --on-sea:#E3EDF2;}}
:root[data-theme="dark"]{--bg:#0B1E2E; --surface:#12293C; --ink:#E3EDF2; --muted:#8FA7B8; --line:#24425A;
  --stb:#3FB37A; --stb-soft:#173A2B; --bb:#E0675C; --bb-soft:#3D1F1D; --sea:#081622; --on-sea:#E3EDF2;}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font:17px/1.55 var(--bfont);-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:var(--hfont);font-weight:600;line-height:1.15;margin:0 0 .4em}
h1{font-size:1.9rem} h2{font-size:1.45rem} h3{font-size:1.15rem}
p{margin:0 0 .8em}
img{max-width:100%}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--buoy);outline-offset:2px}
.wrap{max-width:680px;margin:0 auto;padding:18px 16px 96px}
.muted{color:var(--muted)}
.small{font-size:.9rem}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5em;border:0;border-radius:10px;padding:.8em 1.2em;background:var(--sea);color:var(--on-sea);font-weight:600;min-height:48px}
:root[data-theme="dark"] .btn,.dk .btn{background:#2C5C80}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .btn{background:#2C5C80}}
.btn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--line)}
.btn.wide{width:100%}
.btn:disabled{opacity:.5;cursor:default}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px;margin:0 0 14px}
label{display:block;font-weight:600;margin:14px 0 6px}
input[type=text],input[type=date],select,textarea{width:100%;padding:.7em .8em;border:1.5px solid var(--line);border-radius:10px;background:var(--surface)}
textarea{min-height:80px;resize:vertical}
.opts{display:grid;gap:8px}
.opt{display:flex;gap:.6em;align-items:flex-start;padding:.75em .9em;border:1.5px solid var(--line);border-radius:10px;background:var(--surface);text-align:left;width:100%}
.opt[aria-pressed="true"]{border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}
/* Kurslinie */
.course{background:var(--sea);color:var(--on-sea);border-radius:16px;padding:18px 18px 16px;margin-bottom:16px}
.course .big{font-family:var(--hfont);font-size:2.6rem;font-weight:700;line-height:1}
.track{position:relative;height:34px;margin-top:14px}
.track .ln{position:absolute;left:0;right:0;top:16px;border-top:2px dashed rgba(255,255,255,.35)}
.track .done{position:absolute;left:0;top:15px;height:4px;background:var(--buoy);border-radius:2px}
.track .boat{position:absolute;top:4px;width:26px;height:26px;margin-left:-13px}
.track .goal{position:absolute;right:-4px;top:5px;width:22px;height:24px}
.track{height:58px}
.track .ln{top:28px}.track .done{top:27px}
.track{height:40px}.track .ln{top:22px}.track .done{top:21px}.track .boat{top:6px}.track .goal{top:9px}
.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:.85rem;margin-top:8px;opacity:.9}
.legend span{display:inline-flex;align-items:center;gap:6px}
.legend i{width:10px;height:10px;border-radius:50%;display:inline-block}
.chance{font-family:var(--hfont);font-size:1.15rem;margin-top:4px}
.today{display:flex;gap:10px;flex-wrap:wrap;margin:10px 0 14px}
.today .pill{flex:1 1 120px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:10px 12px}
.today .pill b{display:block;font-family:var(--hfont);font-size:1.6rem;line-height:1.1}
.warn{border-left:4px solid var(--buoy);padding:.6em .9em;background:var(--surface);border-radius:8px;margin:0 0 14px}
/* Quiz */
.qhead{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:10px}
.prog{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin-bottom:16px}
.prog i{display:block;height:100%;background:var(--stb);transition:width .3s}
.qtext{font-size:1.12rem;font-weight:600;margin-bottom:12px}
.qimg{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 14px}
.qimg img{border-radius:8px;border:1px solid var(--line);background:#fff;max-height:200px}
.sig{font-size:1.5rem;letter-spacing:.12em;margin:0 0 14px;font-weight:700}
.ans{display:block;width:100%;text-align:left;padding:.85em 1em;margin:0 0 8px;border:1.5px solid var(--line);border-radius:10px;background:var(--surface);line-height:1.4}
.ans.ok{border-color:var(--stb);background:var(--stb-soft)}
.ans.no{border-color:var(--bb);background:var(--bb-soft)}
.ans:disabled{cursor:default;color:var(--ink)}
.fb{margin-top:6px;padding:12px 14px;border-radius:10px;border:1px solid var(--line);background:var(--surface)}
.tag{font-size:.8rem;color:var(--muted)}
/* topics */
.topic{margin:0 0 14px}
.bar{display:flex;height:10px;border-radius:5px;overflow:hidden;background:var(--line);margin-top:5px}
.bar .m{background:var(--stb)} .bar .l{background:var(--buoy)}
/* chat */
.chat{display:flex;flex-direction:column;gap:10px;margin-bottom:12px}
.msg{max-width:88%;padding:10px 14px;border-radius:14px;white-space:normal}
.msg p:last-child{margin:0}
.msg.u{align-self:flex-end;background:var(--sea);color:var(--on-sea);border-bottom-right-radius:4px}
.msg.a{align-self:flex-start;background:var(--surface);border:1px solid var(--line);border-bottom-left-radius:4px}
.msg .sp{border:0;background:none;color:var(--muted);padding:4px 0 0;font-size:.85rem}
.composer{position:fixed;left:0;right:0;bottom:calc(64px + env(safe-area-inset-bottom,0px));background:var(--bg);border-top:1px solid var(--line);padding:10px 12px}
.composer .in{max-width:680px;margin:0 auto;display:flex;gap:8px;align-items:flex-end}
.composer textarea{min-height:48px;max-height:140px;flex:1}
.mic{width:48px;height:48px;border-radius:50%;border:1.5px solid var(--line);background:var(--surface);display:grid;place-items:center;flex:none}
.mic.on{background:var(--bb);border-color:var(--bb);color:#fff;animation:pulse 1.2s infinite}
@keyframes pulse{50%{box-shadow:0 0 0 8px rgba(184,52,42,.2)}}
@media (prefers-reduced-motion:reduce){.mic.on{animation:none}.prog i{transition:none}}
.toggle{display:flex;align-items:center;gap:.5em;font-size:.9rem;color:var(--muted);margin:0 0 10px}
/* nav */
nav.tabs{position:fixed;left:0;right:0;bottom:0;background:var(--surface);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px);z-index:5}
nav.tabs .in{max-width:680px;margin:0 auto;display:flex}
nav.tabs button{flex:1;border:0;background:none;padding:8px 0 10px;min-height:64px;color:var(--muted);font-size:.8rem;display:flex;flex-direction:column;align-items:center;gap:2px}
nav.tabs button[aria-current="page"]{color:var(--ink);font-weight:600}
nav.tabs svg{width:24px;height:24px}
.hidden{display:none!important}
.lesson p{font-size:1.05rem}
.lesson ul{padding-left:1.2em;margin:0 0 .8em}
.fact{border-left:4px solid var(--buoy);padding:.4em .9em;margin:.6em 0 1em;background:var(--bg);border-radius:0 8px 8px 0}
.row{display:flex;gap:8px;flex-wrap:wrap}
.row>*{flex:1 1 140px}
.think{color:var(--muted);font-style:italic}

.scene{position:relative;margin:4px -16px 14px;}
.scene svg{display:block;width:100%;height:auto}
:root{--sky1:#CFE3EE;--sky2:#EEF5F8;--sea1:#3F86A6;--sea3:#173F58;--hull:#0F2D45;--deck:#E9EEF1;--rig:#2A3E4F;--sail1:#FFFFFF;--sail2:#E3EBF0;--sun:#F3C64A;--cut:#7E5531}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--sky1:#061421;--sky2:#14324A;--sea1:#1C4E6A;--sea3:#06131D;--hull:#2A5677;--deck:#C9D6DE;--rig:#9FB4C3;--sail1:#C9D6DE;--sail2:#93A9B8;--sun:#E9EEF1}}
:root[data-theme="dark"]{--sky1:#061421;--sky2:#14324A;--sea1:#1C4E6A;--sea3:#06131D;--hull:#2A5677;--deck:#C9D6DE;--rig:#9FB4C3;--sail1:#C9D6DE;--sail2:#93A9B8;--sun:#E9EEF1}
.hs{position:absolute;transform:translate(-50%,-50%);display:inline-flex;align-items:center;gap:6px;border:0;border-radius:999px;padding:7px 12px 7px 9px;min-height:36px;background:rgba(255,255,255,.94);color:#0F2D45;font:600 .9rem/1 var(--hfont);letter-spacing:.01em;box-shadow:0 2px 8px rgba(8,22,34,.25);white-space:nowrap}
.hs i{width:10px;height:10px;border-radius:50%;background:#E9B200;box-shadow:0 0 0 3px rgba(233,178,0,.3)}
.hs:hover i{box-shadow:0 0 0 5px rgba(233,178,0,.35)}
@media (min-width:600px){.scene{margin:4px 0 14px;border-radius:16px;overflow:hidden}}
/* Kajüte */
.cast{display:flex;gap:10px;margin:0 0 14px;flex-wrap:wrap}
.cast div{flex:1 1 150px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:10px 12px;font-size:.9rem}
.cast b{font-family:var(--hfont);font-size:1.05rem;display:block}
.line{display:flex;gap:10px;margin:0 0 10px;padding:8px 10px;border-radius:10px;transition:background .2s}
.line.now{background:var(--surface);box-shadow:inset 3px 0 0 var(--buoy)}
.line .who{flex:0 0 64px;font-family:var(--hfont);font-weight:600}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px}


.talkbtn{margin:6px 0 10px;min-height:56px;font-size:1.05rem}
.talkstate{margin:0 0 12px;padding:.7em .9em;border-radius:10px;background:var(--surface);border:1.5px solid var(--line);font-weight:600}
.talkstate[data-st="listen"]{border-color:var(--stb);background:var(--stb-soft)}
.talkstate[data-st="speak"]{border-color:var(--buoy);cursor:pointer}
.hidden{display:none!important}
</style>
</head>
