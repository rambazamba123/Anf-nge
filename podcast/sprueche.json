    {"id": "hi-erkennung-02", "t": "Dor kannst nich meckern.", "b": 3, "e": true},
    {"id": "hi-erkennung-03", "t": "Hinnerk. Mit zwei n und ohne i.", "b": 3, "e": true, "tage": [2, 3, 4, 7], "hinweis": "nur wenn Quirin „Hinni“ sagt"},
    {"id": "hi-erkennung-04", "t": "Tonne zehn.", "b": 3, "e": true, "hinweis": "wenn Smilla zu frech wird (auch Smilla selbst)"},
    {"id": "hi-erkennung-05", "t": "Die See verzeiht nix.", "b": 3, "e": true}
