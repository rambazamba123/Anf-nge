    {"id": "hi-anrede-02", "t": "{{anrede:w=Min Deern|m=Min Jung|n=Landratte}}. Komm mal her.", "tage": [1, 2]},
    {"id": "hi-anrede-03", "t": "Na, {{anrede:w=min Deern|m=min Jung|n=Landratte}}?", "tage": [1, 2]},
    {"id": "hi-anrede-04", "t": "Fass mal mit an, {{anrede:w=Leichtmatrosin|m=Leichtmatrose|n=Frischfisch}}.", "tage": [1, 2]},
    {"id": "hi-anrede-05", "t": "Na, {{anrede:w=Matrosin|m=Matrose|n=Frischling}}? Ausguck. Jetzt.", "tage": [3, 4]},
    {"id": "hi-anrede-06", "t": "{{anrede:w=Matrosin|m=Matrose|n=Frischling}}, übernimm mal die Leine.", "tage": [3, 4]},
    {"id": "hi-anrede-07", "t": "{{anrede:w=Matrosin|m=Matrose|n=Frischling}}. Gut aufgepasst.", "tage": [3, 4]},
    {"id": "hi-anrede-08", "t": "{{anrede:w=Seebärin|m=Seebär|n=Wasserratte}}, du hast die Wache.", "tage": [5, 6]},
    {"id": "hi-anrede-09", "t": "Na, {{anrede:w=Steuerfrau|m=Steuermann|n=Sturmvogel}}? Kurs halten.", "tage": [5, 6]},
    {"id": "hi-anrede-10", "t": "{{anrede:w=Skipperin|m=Skipper|n=Käpt'n}}.", "b": 2, "tage": [6, 7], "hinweis": "Hinnerks leiser Satz, zum ersten Mal an Tag 6 nach dem Sturm (docs/reise.md §2)"},
