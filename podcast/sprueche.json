   "s": [
    {"id": "hi-hafenkino-01", "t": "Und da kommt er. Viel zu schnell. Viel zu schnell!", "b": 1},
    {"id": "hi-hafenkino-02", "t": "Achtung, Seitenwind von rechts, und … nee. Dat wird nix.", "b": 1},
    {"id": "hi-hafenkino-03", "t": "Jetzt der Fender. Wo is der Fender? Kein Fender!", "b": 1},
    {"id": "hi-hafenkino-04", "t": "Und Rückwärtsgang! Zu spät. Klassiker.", "b": 1},
    {"id": "hi-hafenkino-05", "t": "Die Frau springt mit der Leine. Nich springen. Nie springen.", "b": 1},
    {"id": "hi-hafenkino-06", "t": "Großartig. Dat gibt Applaus. Von den Möwen.", "b": 1}
   ]
  },
  {
   "wer": "hinnerk",
   "lage": "frieda",
   "name": "Warum heißt das Boot Frieda? (jedes Mal anders, die Wahrheit kommt nie)",
   "max": 7,
   "s": [
    {"id": "hi-frieda-01", "t": "Nach meiner ersten Liebe. Die is weg. Dat Boot is noch da.", "b": 1, "hinweis": "Variante 1"},
    {"id": "hi-frieda-02", "t": "Frieda war 'ne Kuh auf Pellworm. Die hat mich mal vom Deich geschubst. Respekt.", "b": 1, "hinweis": "Variante 2"},
    {"id": "hi-frieda-03", "t": "Steht für Fahrtüchtiges, Robustes, Immer Dichtes Arbeitsboot. Fast.", "b": 1, "hinweis": "Variante 3: Smilla zählt die Buchstaben nach"},
    {"id": "hi-frieda-04", "t": "Frieda hat mir Siebenundachtzig den Rettungsring zugeworfen. Mehr sag ich nich.", "b": 1, "hinweis": "Variante 4"},
    {"id": "hi-frieda-05", "t": "Die hieß schon so. Und umtaufen bringt Unglück. Weiß jedes Kind.", "b": 1, "hinweis": "Variante 5, passt zum Aberglauben"},
    {"id": "hi-frieda-06", "t": "Nach der Möwe, die mir jeden Morgen dat Brötchen klaut. Frieda. Biest.", "b": 1, "hinweis": "Variante 6"},
    {"id": "hi-frieda-07", "t": "Weil Frieden an Bord herrschen soll. Hat nich geklappt.", "b": 1, "hinweis": "Variante 7, gern als letzte"}
   ]
  },
  {
