    {"id": "kl-erkennung-02", "t": "Hinni! Hinni!", "b": 3, "e": true, "tage": [2, 3, 4, 5, 6, 7], "hinweis": "hat er von Quirin gelernt, also erst ab 2-7"}
   ]
  },
  {
   "wer": "kroeger",
   "lage": "anruf",
   "name": "Anruf eröffnen",
   "bedarf": 18,
   "s": [
    {"id": "ha-anruf-01", "t": "Harms."},
    {"id": "ha-anruf-02", "t": "Hier Harms. Wo seid ihr?"},
    {"id": "ha-anruf-03", "t": "Ich seh euch auf dem Schirm. Spät dran."},
    {"id": "ha-anruf-04", "t": "Moin. Kurz."},
    {"id": "ha-anruf-05", "t": "Ich hab zehn Minuten. Du auch."},
    {"id": "ha-anruf-06", "t": "Ist er da? Egal. Dich will ich."},
    {"id": "ha-anruf-07", "t": "Ich hör Motor. Gut. Dann hörst du mich auch."},
    {"id": "ha-anruf-08", "t": "Harms hier. Hast du Zeit? Du hast Zeit."},
    {"id": "ha-anruf-09", "t": "Moin. Prüfungszeit."},
    {"id": "ha-anruf-10", "t": "Ich ruf an, weil ich's gesagt hab."}
   ]
  },
  {
   "wer": "kroeger",
   "lage": "frage",
   "name": "Frage stellen (darf in einer Folge öfter kommen)",
   "bedarf": 80,
   "oft": true,
   "s": [
    {"id": "ha-frage-01", "t": "Frage.", "b": 6},
    {"id": "ha-frage-02", "t": "Nächste.", "b": 6},
    {"id": "ha-frage-03", "t": "Hör zu.", "b": 6},
    {"id": "ha-frage-04", "t": "Eine noch.", "b": 6},
    {"id": "ha-frage-05", "t": "Dann das hier.", "b": 6},
    {"id": "ha-frage-06", "t": "Mal sehen, ob's sitzt.", "b": 6},
    {"id": "ha-frage-07", "t": "Prüfungsfrage. Im Wortlaut.", "b": 6},
    {"id": "ha-frage-08", "t": "Die kommt bei mir immer.", "b": 6},
    {"id": "ha-frage-09", "t": "Ohne Hilfe. Smilla, du nicht.", "b": 6},
    {"id": "ha-frage-10", "t": "Weiter.", "b": 6},
    {"id": "ha-frage-11", "t": "Und die.", "b": 6},
    {"id": "ha-frage-12", "t": "Zack, nächste.", "b": 6},
    {"id": "ha-frage-13", "t": "Letzte.", "b": 6},
    {"id": "ha-frage-14", "t": "Konzentrier dich.", "b": 6},
    {"id": "ha-frage-15", "t": "Die ist leicht. Angeblich.", "b": 6}
   ]
  },
  {
   "wer": "kroeger",
   "lage": "richtig",
   "name": "Richtig (darf in einer Folge öfter kommen)",
   "bedarf": 60,
   "oft": true,
   "s": [
    {"id": "ha-richtig-01", "t": "Hm.", "b": 6},
    {"id": "ha-richtig-02", "t": "So.", "b": 6},
    {"id": "ha-richtig-03", "t": "Richtig.", "b": 6},
    {"id": "ha-richtig-04", "t": "Stimmt.", "b": 6},
    {"id": "ha-richtig-05", "t": "Na bitte.", "b": 6},
    {"id": "ha-richtig-06", "t": "Das sitzt.", "b": 6},
    {"id": "ha-richtig-07", "t": "Kann man gelten lassen.", "b": 6},
    {"id": "ha-richtig-08", "t": "Korrekt.", "b": 6},
    {"id": "ha-richtig-09", "t": "Ja.", "b": 6},
    {"id": "ha-richtig-10", "t": "Gut gemerkt.", "b": 6},
    {"id": "ha-richtig-11", "t": "In Ordnung.", "b": 6}
   ]
  },
  {
   "wer": "kroeger",
   "lage": "falsch",
   "name": "Falsch (darf in einer Folge öfter kommen)",
   "bedarf": 30,
   "oft": true,
   "s": [
    {"id": "ha-falsch-01", "t": "Falsch.", "b": 4},
    {"id": "ha-falsch-02", "t": "Nein.", "b": 4},
    {"id": "ha-falsch-03", "t": "Daneben.", "b": 4},
    {"id": "ha-falsch-04", "t": "Und warum?", "b": 4},
    {"id": "ha-falsch-05", "t": "Geraten ist nicht gewusst.", "b": 4},
    {"id": "ha-falsch-06", "t": "Das kostet dich in der Prüfung.", "b": 4},
    {"id": "ha-falsch-07", "t": "Nicht ganz. Genau das ist die Falle.", "b": 4},
    {"id": "ha-falsch-08", "t": "Das hätte Hinnerk auch gesagt.", "b": 4},
    {"id": "ha-falsch-09", "t": "Nochmal lesen.", "b": 4},
    {"id": "ha-falsch-10", "t": "Nein. Merk dir die.", "b": 4}
   ]
  },
  {
   "wer": "kroeger",
   "lage": "nachhaken",
   "name": "Nachhaken",
   "bedarf": 15,
   "s": [
    {"id": "ha-nachhaken-01", "t": "Warum?"},
    {"id": "ha-nachhaken-02", "t": "Begründung."},
    {"id": "ha-nachhaken-03", "t": "Und nachts?"},
    {"id": "ha-nachhaken-04", "t": "Und bei Nebel?"},
    {"id": "ha-nachhaken-05", "t": "In einem Satz."},
    {"id": "ha-nachhaken-06", "t": "Was steht im Katalog?"},
    {"id": "ha-nachhaken-07", "t": "Was machst du jetzt? Jetzt."}
   ]
  },
  {
   "wer": "kroeger",
   "lage": "haltung",
   "name": "Haltung",
   "bedarf": 8,
   "s": [
    {"id": "ha-haltung-01", "t": "Ich frag nicht, was du meinst. Ich frag, was gilt.", "b": 2},
    {"id": "ha-haltung-02", "t": "Die See prüft härter als ich.", "b": 2},
    {"id": "ha-haltung-03", "t": "Verstehen. Nicht auswendig.", "b": 2},
    {"id": "ha-haltung-04", "t": "Ich will dich hier ankommen sehen. Mit Schein.", "b": 2},
    {"id": "ha-haltung-05", "t": "Prüfung ist kein Wunschkonzert.", "b": 2}
   ]
  },
  {
   "wer": "kroeger",
   "lage": "ende",
   "name": "Anruf beenden",
   "bedarf": 18,
   "s": [
    {"id": "ha-ende-01", "t": "Das war's."},
    {"id": "ha-ende-02", "t": "Morgen wieder."},
    {"id": "ha-ende-03", "t": "Grüß Hinnerk. Oder lass es."},
    {"id": "ha-ende-04", "t": "Ende."},
    {"id": "ha-ende-05", "t": "Fahrt vorsichtig."},
    {"id": "ha-ende-06", "t": "Harms Ende."},
    {"id": "ha-ende-07", "t": "Pass auf ihn auf.", "tage": [5, 6, 7], "hinweis": "nach Tag 5, über Hinnerk"},
    {"id": "ha-ende-08", "t": "Bis zum nächsten Mal. Üben."},
    {"id": "ha-ende-09", "t": "Schluss für heute."}
   ]
  },
  {
   "wer": "kroeger",
   "lage": "hinnerk",
   "name": "Mit Hinnerk",
   "bedarf": 8,
   "klein": true,
   "s": [
    {"id": "ha-hinnerk-01", "t": "Hinnerk.", "b": 2},
    {"id": "ha-hinnerk-02", "t": "Die Elbe, Hinnerk. Wir wissen beide.", "b": 2},
    {"id": "ha-hinnerk-03", "t": "Im Nebel war keiner zuerst da.", "b": 2},
    {"id": "ha-hinnerk-04", "t": "Immer noch kein Funkgerät, das geht?", "b": 2}
   ]
  },
  {
   "wer": "kroeger",
   "lage": "erkennung",
   "name": "Erkennungssätze",
   "klein": true,
   "s": [
    {"id": "ha-erkennung-01", "t": "Gut.", "b": 1, "e": true, "tage": [7], "hinweis": "genau einmal, an Tag 7"},
    {"id": "ha-erkennung-02", "t": "Geht.", "b": 6, "e": true},
    {"id": "ha-erkennung-03", "t": "Wer klingelt mich da aus der Koje? Ach, du.", "b": 2, "e": true, "hinweis": "nur, wenn du ihn anrufst"},
    {"id": "ha-erkennung-04", "t": "Wer rät, sitzt auf Grund.", "b": 2, "e": true}
   ]
  },
  {
   "wer": "jasper",
   "lage": "einfach",
   "name": "Ganz einfach",
   "bedarf": 6,
   "tage": [4, 5, 6],
   "s": [
    {"id": "ja-einfach-01", "t": "Ganz einfach, Leute:", "b": 2},
    {"id": "ja-einfach-02", "t": "Das hab ich im Gefühl.", "b": 2},
    {"id": "ja-einfach-03", "t": "Wozu Karte, ich kenn das hier.", "b": 2},
    {"id": "ja-einfach-04", "t": "Glaubt mir, ich segel seit zwanzig Jahren.", "b": 2},
    {"id": "ja-einfach-05", "t": "Kinderspiel.", "b": 2}
   ]
  },
  {
   "wer": "jasper",
   "lage": "irrtum",
   "name": "Falsche Faustregeln (Smilla klärt jede in derselben Szene auf)",
   "bedarf": 6,
   "tage": [4, 5, 6],
   "hinweis": "Inhalt geprüft ohne quellen/ (R8): jede Regel ist absichtlich falsch und wird in derselben Szene berichtigt (HR15).",
   "s": [
    {"id": "ja-irrtum-01", "t": "Segler haben immer Vorrang.", "b": 1, "hinweis": "falsch: nicht immer, zum Beispiel nicht als Überholer und nicht gegenüber Schiffen, die nur im Fahrwasser fahren können"},
    {"id": "ja-irrtum-02", "t": "Rot ist immer links. Immer.", "b": 1, "hinweis": "falsch: rot an Backbord gilt nur in Fahrtrichtung von See her"},
    {"id": "ja-irrtum-03", "t": "Wenn ich ihn sehe, sieht er mich auch.", "b": 1, "hinweis": "falsch: kleine Boote verschwinden im Radarschatten und im toten Winkel großer Schiffe"},
    {"id": "ja-irrtum-04", "t": "Nebel? Schneller fahren, dann ist man schneller durch.", "b": 1, "hinweis": "falsch: bei verminderter Sicht sichere Geschwindigkeit"},
    {"id": "ja-irrtum-05", "t": "Anker? So viel Kette, wie es tief ist. Reicht.", "b": 1, "hinweis": "falsch: deutlich mehr Kette als die Wassertiefe"},
    {"id": "ja-irrtum-06", "t": "Zwei Lichter übereinander? Zwei kleine Boote.", "b": 1, "hinweis": "falsch: ein Fahrzeug mit besonderer Lichterführung"}
   ]
  },
  {
   "wer": "jasper",
   "lage": "segel",
   "name": "Segel gegen Motor",
   "bedarf": 4,
   "klein": true,
   "tage": [4, 5, 6],
   "s": [
    {"id": "ja-segel-01", "t": "Na, ihr Stinker?", "b": 1},
    {"id": "ja-segel-02", "t": "Echte Seeleute brauchen keinen Motor.", "b": 1},
    {"id": "ja-segel-03", "t": "Ich riech euch, bevor ich euch seh.", "b": 1},
    {"id": "ja-segel-04", "t": "Motorboot. Süß.", "b": 1}
   ]
  },
  {
   "wer": "jasper",
   "lage": "danach",
   "name": "Nach der Rettung (6-6)",
   "bedarf": 2,
   "klein": true,
   "tage": [6],
   "s": [
    {"id": "ja-danach-01", "t": "Danke. Ehrlich.", "b": 1},
    {"id": "ja-danach-02", "t": "Ich weiß es nicht. Also das alles.", "b": 1},
    {"id": "ja-danach-03", "t": "Ich hätt die Karte mitnehmen sollen.", "b": 1}
   ]
  },
  {
   "wer": "jasper",
   "lage": "erkennung",
   "name": "Erkennungssätze",
   "klein": true,
   "tage": [4, 5, 6],
   "s": [
    {"id": "ja-erkennung-01", "t": "Ich sag immer Nord.", "b": 2, "e": true}
   ]
  },
  {
   "wer": "hafen",
   "lage": "hafen",
   "name": "Hafenmeisterin Kuttershaven",
   "bedarf": 6,
   "s": [
    {"id": "hm-hafen-01", "t": "Erst melden, dann festmachen.", "b": 2},
    {"id": "hm-hafen-02", "t": "Fender raus, bevor du bei mir anlegst.", "b": 2},
    {"id": "hm-hafen-03", "t": "Hab ich gesehen. Alle haben das gesehen.", "b": 2},
    {"id": "hm-hafen-04", "t": "Hinnerk, dein Strom ist nicht bezahlt.", "b": 2},
    {"id": "hm-hafen-05", "t": "Liegeplatz drei. Und diesmal mit Fendern.", "b": 2}
   ]
  }
 ]
}
