    {"id": "hi-fluch-02", "t": "Pütz und Persenning!", "b": 1},
    {"id": "hi-fluch-03", "t": "Rasmus soll di holen!", "b": 1},
    {"id": "hi-fluch-04", "t": "Bilgenwasser noch eins!", "b": 1},
    {"id": "hi-fluch-05", "t": "Tüddelkram vermaledeiter!", "b": 1},
    {"id": "hi-fluch-06", "t": "Kielschwein und Krabbenpuhler!", "b": 1},
    {"id": "hi-fluch-07", "t": "Klabauter und Kombüsenfett!", "b": 1},
    {"id": "hi-fluch-08", "t": "Heringsschwanz und Hafenschlick!", "b": 1},
    {"id": "hi-fluch-09", "t": "Donner un Düwel!", "b": 1},
    {"id": "hi-fluch-10", "t": "Fender und Feuerhaken!", "b": 1},
    {"id": "hi-fluch-11", "t": "Pinne, Pütz und Pottwal!", "b": 1},
    {"id": "hi-fluch-12", "t": "Labskaus mit Leberwurst!", "b": 1},
    {"id": "hi-fluch-13", "t": "Ankerkette noch mal!", "b": 1},
    {"id": "hi-fluch-14", "t": "Schiet di wat!", "b": 1},
    {"id": "hi-fluch-15", "t": "Dreimal verdammte Schietbüdelei!", "b": 1},
    {"id": "hi-fluch-16", "t": "Muschel am Kiel!", "b": 1},
    {"id": "hi-fluch-17", "t": "Rostiger Schäkel!", "b": 1},
    {"id": "hi-fluch-18", "t": "Leck mi doch am Ruder!", "b": 1},
    {"id": "hi-fluch-19", "t": "Bei Neptuns nassen Socken!", "b": 1},
    {"id": "hi-fluch-20", "t": "Möwendreck und Mastkorb!", "b": 1}
