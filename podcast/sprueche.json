  {
   "wer": "hinnerk",
   "lage": "ertappt",
   "name": "Ertappt",
   "bedarf": 18,
   "s": [
    {"id": "hi-ertappt-01", "t": "Dat meinte ich ja."},
    {"id": "hi-ertappt-02", "t": "Is mir so rausgerutscht."},
    {"id": "hi-ertappt-03", "t": "Dat Dingens hier is schuld."},
    {"id": "hi-ertappt-04", "t": "Wer will Kaffee?"},
    {"id": "hi-ertappt-05", "t": "Na ja."},
    {"id": "hi-ertappt-06", "t": "Die Regel is neu. Höchstens dreißig Jahre."},
    {"id": "hi-ertappt-07", "t": "Dat stand früher anders im Buch."},
    {"id": "hi-ertappt-08", "t": "Hab ich doch gesagt. So ungefähr."},
    {"id": "hi-ertappt-09", "t": "Ich wollt nur sehen, ob du aufpasst."},
    {"id": "hi-ertappt-10", "t": "Dat war 'n Test. Bestanden."}
   ]
  },
  {
