   "bedarf": 21,
   "s": [
    {"id": "hi-tadel-01", "t": "Nochmal."},
    {"id": "hi-tadel-02", "t": "Dat war nix."},
    {"id": "hi-tadel-03", "t": "Und wat war dat jetzt?"},
    {"id": "hi-tadel-04", "t": "Dafür is der Fender da. Leider."},
    {"id": "hi-tadel-05", "t": "Atmen. Und nochmal."},
    {"id": "hi-tadel-06", "t": "Einmal is Glück. Zeig's zweimal."},
    {"id": "hi-tadel-07", "t": "So legt man nich an, so legt man sich an."},
    {"id": "hi-tadel-08", "t": "Dat üben wir nochmal. Und nochmal."},
    {"id": "hi-tadel-09", "t": "Schön war dat nich. Aber lehrreich."},
    {"id": "hi-tadel-10", "t": "Wenn dat Harms gesehen hätt …"}
   ]
  },
  {
   "wer": "hinnerk",
   "lage": "staunen",
   "name": "Staunen",
   "bedarf": 15,
   "s": [
    {"id": "hi-staunen-01", "t": "Kiek an."},
    {"id": "hi-staunen-02", "t": "Na sowas."},
    {"id": "hi-staunen-03", "t": "Donnerlüttchen."},
    {"id": "hi-staunen-04", "t": "Dat hab ich noch nie gesehen. Doch. Siebenundachtzig."},
    {"id": "hi-staunen-05", "t": "Nu brat mir einer 'n Storch."},
    {"id": "hi-staunen-06", "t": "Dat glaubt mir zuhaus keiner."},
    {"id": "hi-staunen-07", "t": "Ach du dicker Pott."},
    {"id": "hi-staunen-08", "t": "Na, dor kiek an."}
   ]
