  {
   "wer": "hinnerk",
   "lage": "gruss",
   "name": "Grüßen",
   "bedarf": 30,
   "s": [
    {"id": "hi-gruss-01", "t": "Moin."},
    {"id": "hi-gruss-02", "t": "Moin, moin."},
    {"id": "hi-gruss-03", "t": "Na?"},
    {"id": "hi-gruss-04", "t": "Ah. Da biste ja."},
    {"id": "hi-gruss-05", "t": "Kaffee steht."},
    {"id": "hi-gruss-06", "t": "Ausgeschlafen? Schad. Ich auch nich."},
    {"id": "hi-gruss-07", "t": "Morgen. Wind kommt aus West, Laune aus Nord."},
    {"id": "hi-gruss-08", "t": "Moin. Nich so laut, die Möwen schlafen noch."},
    {"id": "hi-gruss-09", "t": "Na, auch schon wach?"},
    {"id": "hi-gruss-10", "t": "Moin. Kaffee is schwarz, Wetter auch."},
    {"id": "hi-gruss-11", "t": "Da kommt ja wer."},
    {"id": "hi-gruss-12", "t": "Moin. Hast du gut gelegen? Ich nich. Die Koje is zu kurz. Seit vierzig Jahren."},
    {"id": "hi-gruss-13", "t": "Moin. Erst Kaffee, dann reden."},
    {"id": "hi-gruss-14", "t": "Ah, Besuch. Wisch dir die Füße ab, dat is 'n Schiff und kein Kuhstall."}
   ]
  },
  {
   "wer": "hinnerk",
   "lage": "ja",
   "name": "Zustimmen",
   "bedarf": 36,
   "s": [
    {"id": "hi-ja-01", "t": "Jo."},
    {"id": "hi-ja-02", "t": "Kann man so machen."},
    {"id": "hi-ja-03", "t": "Dor is wat dran."},
    {"id": "hi-ja-04", "t": "Meinetwegen."},
    {"id": "hi-ja-05", "t": "So is dat."},
    {"id": "hi-ja-06", "t": "Lass laufen."},
    {"id": "hi-ja-07", "t": "Recht hast. Sag ich aber nich nochmal."},
    {"id": "hi-ja-08", "t": "Hm. Ja."},
    {"id": "hi-ja-09", "t": "Von mir aus."},
    {"id": "hi-ja-10", "t": "Jo, jo."},
    {"id": "hi-ja-11", "t": "Is gut so."},
    {"id": "hi-ja-12", "t": "Mach man."},
    {"id": "hi-ja-13", "t": "Hätt ich auch so gemacht. Fast."},
    {"id": "hi-ja-14", "t": "Dat lass ich gelten."}
   ]
  },
  {
   "wer": "hinnerk",
   "lage": "nein",
   "name": "Ablehnen",
   "bedarf": 24,
   "s": [
    {"id": "hi-nein-01", "t": "Nee."},
    {"id": "hi-nein-02", "t": "Nix da."},
    {"id": "hi-nein-03", "t": "Finger weg."},
    {"id": "hi-nein-04", "t": "Is nich."},
    {"id": "hi-nein-05", "t": "Da fahr ich nich hin, da wohnt der Grund."},
    {"id": "hi-nein-06", "t": "Später. Vielleicht."},
    {"id": "hi-nein-07", "t": "Kommt nich in die Tüte."},
    {"id": "hi-nein-08", "t": "Über meine Leiche. Und die schwimmt nich."},
    {"id": "hi-nein-09", "t": "Nee, nee, nee."},
    {"id": "hi-nein-10", "t": "Dat lassen wir mal schön."},
    {"id": "hi-nein-11", "t": "Heute nich. Morgen auch nich."},
    {"id": "hi-nein-12", "t": "Dat hab ich vierzig Jahre nich gebraucht."}
   ]
  },
  {
   "wer": "hinnerk",
   "lage": "warnen",
   "name": "Warnen",
   "bedarf": 24,
   "s": [
    {"id": "hi-warnen-01", "t": "Wahrschau!"},
    {"id": "hi-warnen-02", "t": "Kiek mol, wat da kommt."},
    {"id": "hi-warnen-03", "t": "Hände weg vom Gas."},
    {"id": "hi-warnen-04", "t": "Langsam. Ganz langsam."},
    {"id": "hi-warnen-05", "t": "Halt dich fest."},
    {"id": "hi-warnen-06", "t": "Kopf runter!"},
    {"id": "hi-warnen-07", "t": "Erst die Weste. Dann reden wir."},
    {"id": "hi-warnen-08", "t": "Jetzt hör genau zu."},
    {"id": "hi-warnen-09", "t": "Pass op!"},
    {"id": "hi-warnen-10", "t": "Fuß weg von der Leine!"},
    {"id": "hi-warnen-11", "t": "Da vorn wird's flach."},
    {"id": "hi-warnen-12", "t": "Nich hinter die Leine stellen. Nie."}
   ]
  },
  {
   "wer": "hinnerk",
   "lage": "lob",
   "name": "Indirekt loben",
   "bedarf": 36,
   "s": [
    {"id": "hi-lob-01", "t": "Hm."},
    {"id": "hi-lob-02", "t": "Geht doch."},
    {"id": "hi-lob-03", "t": "Hab schon Schlimmeres gesehen."},
    {"id": "hi-lob-04", "t": "Wird langsam."},
    {"id": "hi-lob-05", "t": "Na also."},
    {"id": "hi-lob-06", "t": "Siehste."},
    {"id": "hi-lob-07", "t": "Smilla, schreib dat auf. Nee, lass."},
    {"id": "hi-lob-08", "t": "Dat war nich schlecht. Sag ich nur einmal."},
    {"id": "hi-lob-09", "t": "Kann man nich meckern. Fast."},
    {"id": "hi-lob-10", "t": "Ha. Na ja. Doch."},
    {"id": "hi-lob-11", "t": "Is ja nich zum Aushalten, wie gut dat lief."},
    {"id": "hi-lob-12", "t": "Dat hätt ich mit zwanzig nich gekonnt. Mit dreißig auch nich."},
    {"id": "hi-lob-13", "t": "Weiter so. Nich übermütig werden."},
    {"id": "hi-lob-14", "t": "Hm. Hm, hm."}
   ]
  },
  {
   "wer": "hinnerk",
   "lage": "deins",
   "name": "Wenn etwas jetzt dir gehört (Ausbildungsheft)",
   "bedarf": 15,
   "s": [
    {"id": "hi-deins-01", "t": "Dat gehört jetzt dir."},
    {"id": "hi-deins-02", "t": "Mach du man."},
    {"id": "hi-deins-03", "t": "Kannst du. Ab jetzt du."},
    {"id": "hi-deins-04", "t": "Dat machst ab heute du. Ich guck nur noch."},
    {"id": "hi-deins-05", "t": "Dor brauchst mich nich mehr für."},
    {"id": "hi-deins-06", "t": "Dat sitzt. Dat nimmt dir keiner mehr."}
   ]
