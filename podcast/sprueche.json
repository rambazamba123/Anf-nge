  {
   "wer": "smilla",
   "lage": "gruss",
   "name": "Grüßen",
   "bedarf": 30,
   "s": [
    {"id": "sm-gruss-01", "t": "Moin! Kaffee? Nee? Dann Tee."},
    {"id": "sm-gruss-02", "t": "Na, gut geschlafen?"},
    {"id": "sm-gruss-03", "t": "Da bist du ja! Wir haben was vor."},
    {"id": "sm-gruss-04", "t": "Moin, moin. Hinnerk ist seit fünf wach, sag nix."},
    {"id": "sm-gruss-05", "t": "Hallo, hallo!"},
    {"id": "sm-gruss-06", "t": "Guten Morgen!"},
    {"id": "sm-gruss-07", "t": "Moin! Heute wird's spannend, versprochen."},
    {"id": "sm-gruss-08", "t": "Na, ausgeschlafen? Du siehst aus wie Backbord."},
    {"id": "sm-gruss-09", "t": "Moin! Ich hab schon alles vorbereitet. Fast alles."},
    {"id": "sm-gruss-10", "t": "Morgen! Erst Wetterbericht, dann Frühstück."},
    {"id": "sm-gruss-11", "t": "Da ist ja unser Neuzugang!"},
    {"id": "sm-gruss-12", "t": "Moin! Hast du die Leinen gehört heute Nacht? Ich auch."}
   ]
  },
  {
   "wer": "smilla",
   "lage": "erklaeren",
   "name": "Erklären anfangen (wechseln!)",
   "bedarf": 60,
   "s": [
    {"id": "sm-erklaeren-01", "t": "Pass auf, ganz einfach:"},
    {"id": "sm-erklaeren-02", "t": "Stell dir vor …"},
    {"id": "sm-erklaeren-03", "t": "Kurz und schmerzlos:"},
    {"id": "sm-erklaeren-04", "t": "Das ist wie beim …"},
    {"id": "sm-erklaeren-05", "t": "Weißt du, warum das so ist?"},
    {"id": "sm-erklaeren-06", "t": "Ich mal's dir auf."},
    {"id": "sm-erklaeren-07", "t": "Der Trick dabei:"},
    {"id": "sm-erklaeren-08", "t": "Das Fiese an der Frage ist …"},
    {"id": "sm-erklaeren-09", "t": "Drei Sachen."},
    {"id": "sm-erklaeren-10", "t": "Ganz ehrlich? Das ist logisch, wenn man's einmal sieht."},
    {"id": "sm-erklaeren-11", "t": "Mach mal die Augen zu."},
    {"id": "sm-erklaeren-12", "t": "Merk dir nur eins:"},
    {"id": "sm-erklaeren-13", "t": "Hinnerk macht das nach Gefühl. Ich erklär dir das Warum."},
    {"id": "sm-erklaeren-14", "t": "Gute Frage. Wirklich."},
    {"id": "sm-erklaeren-15", "t": "Das klingt komplizierter, als es ist."},
    {"id": "sm-erklaeren-16", "t": "Lass uns das mal umdrehen:"},
    {"id": "sm-erklaeren-17", "t": "Was glaubst du, wer hier wen sehen muss?"},
    {"id": "sm-erklaeren-18", "t": "Das hab ich in der Prüfung auch falsch gehabt. Also:"},
    {"id": "sm-erklaeren-19", "t": "Andersrum gefragt:"},
    {"id": "sm-erklaeren-20", "t": "Schau mal da rüber."}
   ]
  },
  {
   "wer": "smilla",
   "lage": "berichtigen",
   "name": "Berichtigen",
   "bedarf": 30,
   "s": [
    {"id": "sm-berichtigen-01", "t": "Fast."},
    {"id": "sm-berichtigen-02", "t": "Schöne Geschichte. Stimmt nur nicht."},
    {"id": "sm-berichtigen-03", "t": "Käpt'n, das ist Tünkram."},
    {"id": "sm-berichtigen-04", "t": "Moment mal."},
    {"id": "sm-berichtigen-05", "t": "Darf ich kurz?"},
    {"id": "sm-berichtigen-06", "t": "Das war vielleicht 1987 so."},
    {"id": "sm-berichtigen-07", "t": "Da muss ich widersprechen, und zwar laut."},
    {"id": "sm-berichtigen-08", "t": "Nicht ganz."},
    {"id": "sm-berichtigen-09", "t": "Knapp daneben ist auch vorbei."},
    {"id": "sm-berichtigen-10", "t": "Das sagt ihr am Main vielleicht so. Hier nicht."},
    {"id": "sm-berichtigen-11", "t": "Hübsch. Aber nein."},
    {"id": "sm-berichtigen-12", "t": "Das glaubst du doch selber nicht."}
   ]
  },
  {
   "wer": "smilla",
   "lage": "anerkennen",
   "name": "Anerkennen",
   "bedarf": 30,
   "s": [
    {"id": "sm-anerkennen-01", "t": "Sauber."},
    {"id": "sm-anerkennen-02", "t": "Siehste, wusstest du."},
    {"id": "sm-anerkennen-03", "t": "Genau so."},
    {"id": "sm-anerkennen-04", "t": "Punkt für dich."},
    {"id": "sm-anerkennen-05", "t": "Ha! Wusst ich's."},
    {"id": "sm-anerkennen-06", "t": "Ich bin fast stolz."},
    {"id": "sm-anerkennen-07", "t": "Das war richtig gut."},
    {"id": "sm-anerkennen-08", "t": "Na bitte, geht doch!"},
    {"id": "sm-anerkennen-09", "t": "Volltreffer."},
    {"id": "sm-anerkennen-10", "t": "So schnell? Respekt."},
    {"id": "sm-anerkennen-11", "t": "Das schreib ich ins Logbuch."},
    {"id": "sm-anerkennen-12", "t": "Guck an, da hat jemand aufgepasst."}
   ]
  },
  {
   "wer": "smilla",
   "lage": "antreiben",
   "name": "Antreiben",
   "bedarf": 20,
   "s": [
    {"id": "sm-antreiben-01", "t": "Noch eine. Komm."},
    {"id": "sm-antreiben-02", "t": "Nicht schlappmachen."},
    {"id": "sm-antreiben-03", "t": "Einmal noch, dann Kaffee."},
    {"id": "sm-antreiben-04", "t": "Wer jetzt aufhört, fängt morgen von vorne an."},
    {"id": "sm-antreiben-05", "t": "Zehn Minuten. Das schaffst du im Schlaf."},
    {"id": "sm-antreiben-06", "t": "Los, los, die Tide wartet nicht."},
    {"id": "sm-antreiben-07", "t": "Eine noch. Für mich."},
    {"id": "sm-antreiben-08", "t": "Durchziehen. Dann Pause."}
   ]
  },
  {
   "wer": "smilla",
   "lage": "ungeduld",
   "name": "Ungeduld",
   "bedarf": 12,
   "s": [
    {"id": "sm-ungeduld-01", "t": "Ja, ja, ja."},
    {"id": "sm-ungeduld-02", "t": "Wir haben nicht ewig, Käpt'n."},
    {"id": "sm-ungeduld-03", "t": "Jetzt mach schon."},
    {"id": "sm-ungeduld-04", "t": "So sind wir Weihnachten da."},
    {"id": "sm-ungeduld-05", "t": "Käpt'n, die Tide!"},
    {"id": "sm-ungeduld-06", "t": "Hallo? Erde an Hinnerk?"}
   ]
  },
  {
   "wer": "smilla",
   "lage": "koelsch",
   "name": "Kölsch mit Seefahrts-Dreh",
   "bedarf": 12,
   "s": [
    {"id": "sm-koelsch-01", "t": "Et es wie et es.", "b": 2},
    {"id": "sm-koelsch-02", "t": "Et kütt wie et kütt? Nicht auf See. Da kommt, was du vorher geplant hast.", "b": 2},
    {"id": "sm-koelsch-03", "t": "Wat fott es, es fott.", "b": 2},
    {"id": "sm-koelsch-04", "t": "Et bliev nix wie et wor.", "b": 2},
    {"id": "sm-koelsch-05", "t": "Wat soll dä Quatsch?", "b": 2},
    {"id": "sm-koelsch-06", "t": "Jede Jeck es anders.", "b": 2},
    {"id": "sm-koelsch-07", "t": "Et hätt noch immer jot jejange? Sagt man bei uns. Auf dem Wasser verlass ich mich da nicht drauf.", "b": 2},
    {"id": "sm-koelsch-08", "t": "Mer muss och jönne könne.", "b": 2},
    {"id": "sm-koelsch-09", "t": "Do laachs de dich kapott.", "b": 2}
   ]
  },
  {
   "wer": "smilla",
   "lage": "erwischt",
   "name": "Selbst falsch erwischt",
   "bedarf": 8,
   "s": [
    {"id": "sm-erwischt-01", "t": "Okay. Okay. Punkt für dich, Käpt'n.", "b": 2},
    {"id": "sm-erwischt-02", "t": "Hab ich verwechselt. Rhein-Gewohnheit.", "b": 2},
    {"id": "sm-erwischt-03", "t": "Weiß ich nicht genau, schlag ich nach.", "b": 2},
    {"id": "sm-erwischt-04", "t": "Mist.", "b": 2},
    {"id": "sm-erwischt-05", "t": "Sag's keinem.", "b": 2},
    {"id": "sm-erwischt-06", "t": "Na gut. Einmal im Jahr darf ich.", "b": 2}
   ]
  },
  {
   "wer": "smilla",
   "lage": "trost",
   "name": "Wenn du falsch liegst",
   "bedarf": 24,
   "s": [
    {"id": "sm-trost-01", "t": "Kein Drama. Genau dafür üben wir."},
    {"id": "sm-trost-02", "t": "Lieber hier falsch als bei Harms."},
    {"id": "sm-trost-03", "t": "Das ist die Falle. Da tappen alle rein."},
    {"id": "sm-trost-04", "t": "Fast. Und fast ist schon mal was."},
    {"id": "sm-trost-05", "t": "Macht nix. Merk dir nur, warum."},
    {"id": "sm-trost-06", "t": "Gut, dass das jetzt passiert ist."},
    {"id": "sm-trost-07", "t": "Kopf hoch. Die merkst du dir jetzt für immer."},
    {"id": "sm-trost-08", "t": "Atmen. Nochmal von vorne."},
    {"id": "sm-trost-09", "t": "Das war die zweitbeste Antwort. Leider zählt nur die beste."}
   ]
  },
  {
   "wer": "smilla",
   "lage": "abschied",
   "name": "Abschied",
   "bedarf": 20,
   "s": [
    {"id": "sm-abschied-01", "t": "Tschö!"},
    {"id": "sm-abschied-02", "t": "Bis morgen, und ohne Nachsitzen."},
    {"id": "sm-abschied-03", "t": "Gute Nacht, ihr Süßwassermatrosen."},
    {"id": "sm-abschied-04", "t": "Schlaf schön. Ich mach noch Logbuch."},
    {"id": "sm-abschied-05", "t": "Tschö mit ö!"},
    {"id": "sm-abschied-06", "t": "Gute Nacht. Und träum nicht von Tonnen."},
    {"id": "sm-abschied-07", "t": "Bis morgen. Wecker auf sechs."},
    {"id": "sm-abschied-08", "t": "Nacht, Käpt'n. Mach die Lampe nicht so spät aus."}
   ]
  },
  {
   "wer": "smilla",
   "lage": "anrede",
   "name": "Dich ansprechen",
   "bedarf": 21,
   "s": [
    {"id": "sm-anrede-01", "t": "Na, {{anrede:w=Leichtmatrosin|m=Leichtmatrose|n=Bordküken}}?", "tage": [1, 2]},
    {"id": "sm-anrede-02", "t": "Komm her, {{anrede:w=Leichtmatrosin|m=Leichtmatrose|n=Frischfisch}}, ich zeig dir was.", "tage": [1, 2]},
    {"id": "sm-anrede-03", "t": "{{anrede:w=Frau Neuzugang|m=Herr Neuzugang|n=Landei}}, aufgepasst.", "tage": [1, 2]},
    {"id": "sm-anrede-04", "t": "Na, {{anrede:w=Matrosin|m=Matrose|n=Frischling}}, schon wach?", "tage": [3, 4]},
    {"id": "sm-anrede-05", "t": "{{anrede:w=Matrosin|m=Matrose|n=Frischling}}, Ausguck nach vorn!", "tage": [3, 4]},
    {"id": "sm-anrede-06", "t": "Nicht schlecht, {{anrede:w=Seebärin|m=Seebär|n=Wasserratte}}.", "tage": [5, 6]},
    {"id": "sm-anrede-07", "t": "{{anrede:w=Steuerfrau|m=Steuermann|n=Sturmvogel}}, Kurs?", "tage": [5, 6]},
    {"id": "sm-anrede-08", "t": "Na, {{anrede:w=Skipperin|m=Skipper|n=Käpt'n}}? Bereit?", "tage": [7]}
   ]
  },
  {
   "wer": "smilla",
   "lage": "logbuch",
   "name": "Logbuch schreiben (Rahmen der Fragerunde)",
   "bedarf": 14,
   "s": [
    {"id": "sm-logbuch-01", "t": "Logbuch. Ich diktier, du sagst die Antwort."},
    {"id": "sm-logbuch-02", "t": "Zeit fürs Logbuch. Und keine Krickelmännchen, das mach ich."},
    {"id": "sm-logbuch-03", "t": "Logbuch, Eintrag für heute. Erste Frage."},
    {"id": "sm-logbuch-04", "t": "Stift raus. Was haben wir heute gelernt?"},
    {"id": "sm-logbuch-05", "t": "Ich schreib, du antwortest. Deal?"},
    {"id": "sm-logbuch-06", "t": "Logbuch. Hinnerk, du bist still."}
   ]
  },
  {
   "wer": "smilla",
   "lage": "wetten",
   "name": "Wetten mit Quirin (nur solange er an Bord ist)",
   "bedarf": 8,
   "tage": [2, 3, 4, 7],
   "s": [
    {"id": "sm-wetten-01", "t": "Wetten? Wer verliert, macht den Abwasch."},
    {"id": "sm-wetten-02", "t": "Abwasch, Quirin. Du weißt, was das heißt."},
    {"id": "sm-wetten-03", "t": "Neue Wette. Doppelter Abwasch."},
    {"id": "sm-wetten-04", "t": "Ich hab gewonnen. Spülmittel steht unter der Spüle."},
    {"id": "sm-wetten-05", "t": "Okay, du hast gewonnen. Einmal. Feier's nicht."},
    {"id": "sm-wetten-06", "t": "Steht's jetzt drei zu eins? Für mich."}
   ]
  },
  {
   "wer": "smilla",
   "lage": "erkennung",
   "name": "Erkennungssätze",
   "klein": true,
   "s": [
    {"id": "sm-erkennung-01", "t": "Nee, Käpt'n.", "b": 8, "e": true},
    {"id": "sm-erkennung-02", "t": "Na also, Seegurke. Geht doch.", "b": 3, "e": true},
    {"id": "sm-erkennung-03", "t": "Merk dir das Warum.", "b": 2, "e": true}
   ]
  },
  {
   "wer": "quirin",
   "lage": "gruss",
   "name": "Grüßen",
   "bedarf": 12,
   "tage": [2, 3, 4, 7],
   "s": [
    {"id": "qu-gruss-01", "t": "Servus mitanand!"},
    {"id": "qu-gruss-02", "t": "Griaß eich!"},
    {"id": "qu-gruss-03", "t": "Guad'n Morgn!"},
    {"id": "qu-gruss-04", "t": "Servus, Hinni!"},
    {"id": "qu-gruss-05", "t": "Moin? Moin! I lern's no."},
    {"id": "qu-gruss-06", "t": "Griaß di!"},
    {"id": "qu-gruss-07", "t": "Servus! Hod oana an Kaffee?"}
   ]
  },
  {
   "wer": "quirin",
   "lage": "staunen",
   "name": "Staunen",
   "bedarf": 15,
   "tage": [2, 3, 4, 7],
   "s": [
    {"id": "qu-staunen-01", "t": "Mei!"},
    {"id": "qu-staunen-02", "t": "Do legst di nieda!"},
    {"id": "qu-staunen-03", "t": "Schaug her!"},
    {"id": "qu-staunen-04", "t": "Des gibt's ja ned!"},
    {"id": "qu-staunen-05", "t": "Wahnsinn!"},
    {"id": "qu-staunen-06", "t": "Ja, Herrschaftszeiten!"},
    {"id": "qu-staunen-07", "t": "Ja, Kruzifix!"},
    {"id": "qu-staunen-08", "t": "Ja, gibt's denn sowas?"}
   ]
  },
  {
   "wer": "quirin",
   "lage": "fragen",
   "name": "Fragen",
   "bedarf": 24,
   "tage": [2, 3, 4, 7],
   "s": [
    {"id": "qu-fragen-01", "t": "Warum eigentlich?"},
    {"id": "qu-fragen-02", "t": "Wos hoaßt des jetzt genau?"},
    {"id": "qu-fragen-03", "t": "Und bei uns aufm Main wär des …?"},
    {"id": "qu-fragen-04", "t": "Sorry, wos is a Luv?"},
    {"id": "qu-fragen-05", "t": "Moment, mitschreim."},
    {"id": "qu-fragen-06", "t": "Gilt des aa für mi?"},
    {"id": "qu-fragen-07", "t": "Und wenn ned?"},
    {"id": "qu-fragen-08", "t": "Des muass i jetzt ned wissen, oder?"},
    {"id": "qu-fragen-09", "t": "Und woher woaß i des?"},
    {"id": "qu-fragen-10", "t": "Kannst des nomoi sagn? Langsam?"}
   ]
  },
  {
   "wer": "quirin",
   "lage": "kennen",
   "name": "Das kenn ich",
   "bedarf": 12,
   "tage": [2, 3, 4, 7],
   "s": [
    {"id": "qu-kennen-01", "t": "Lass mi, des kenn i."},
    {"id": "qu-kennen-02", "t": "Den Knoten kenn i, bei uns hoaßt der Mastwurf."},
    {"id": "qu-kennen-03", "t": "Gas weg, kurz zruck, scho steht's."},
    {"id": "qu-kennen-04", "t": "In da Schleus'n hob i des tausendmoi gmacht."},
    {"id": "qu-kennen-05", "t": "Ned zerren. Vorspringa."},
    {"id": "qu-kennen-06", "t": "Des is wia dahoam. Fast."}
   ]
  },
  {
   "wer": "quirin",
   "lage": "seekrank",
   "name": "Seekrank",
   "bedarf": 8,
   "tage": [2, 3, 4, 7],
   "s": [
    {"id": "qu-seekrank-01", "t": "I schaug moi ned aufs Wasser."},
    {"id": "qu-seekrank-02", "t": "Is des imma so wacklig?"},
    {"id": "qu-seekrank-03", "t": "Brotzeit? Na, danke."},
    {"id": "qu-seekrank-04", "t": "Mei Mogn is no in Kelheim."},
    {"id": "qu-seekrank-05", "t": "Horizont. I schaug auf'n Horizont. Hod da Hinni gsagt."},
    {"id": "qu-seekrank-06", "t": "Es geht scho. Es geht. Na, es geht ned."}
   ]
  },
  {
   "wer": "quirin",
   "lage": "selbst",
   "name": "Über sich lachen",
   "bedarf": 10,
   "tage": [2, 3, 4, 7],
   "s": [
    {"id": "qu-selbst-01", "t": "I Depp, i."},
    {"id": "qu-selbst-02", "t": "Des war jetzt ned so plant."},
    {"id": "qu-selbst-03", "t": "Do hob i mi gschwind blamiert."},
    {"id": "qu-selbst-04", "t": "Bassd scho, i lern ja no."},
    {"id": "qu-selbst-05", "t": "Hob i scho wieda Binnen denkt."},
    {"id": "qu-selbst-06", "t": "Sogt's meim Vadda nix."}
   ]
  },
  {
   "wer": "quirin",
   "lage": "ja",
   "name": "Zustimmen",
   "bedarf": 12,
   "tage": [2, 3, 4, 7],
   "s": [
    {"id": "qu-ja-01", "t": "Bassd."},
    {"id": "qu-ja-02", "t": "Freilich!"},
    {"id": "qu-ja-03", "t": "Pack ma's!"},
    {"id": "qu-ja-04", "t": "Genau so."},
    {"id": "qu-ja-05", "t": "Aber sicher."},
    {"id": "qu-ja-06", "t": "Do host recht."}
   ]
  },
  {
   "wer": "quirin",
   "lage": "aerger",
   "name": "Ärger",
   "bedarf": 6,
   "tage": [2, 3, 4, 7],
   "s": [
    {"id": "qu-aerger-01", "t": "Mei, so a Schmarrn!"},
    {"id": "qu-aerger-02", "t": "Sakra!"},
    {"id": "qu-aerger-03", "t": "Des derf ned wahr sei."},
    {"id": "qu-aerger-04", "t": "Zefix!"},
    {"id": "qu-aerger-05", "t": "So a Graffl!"}
   ]
  },
  {
   "wer": "quirin",
   "lage": "abschied",
   "name": "Abschied",
   "bedarf": 10,
   "tage": [2, 3, 4, 7],
   "s": [
    {"id": "qu-abschied-01", "t": "Pfiat eich!"},
    {"id": "qu-abschied-02", "t": "Servus!"},
    {"id": "qu-abschied-03", "t": "Guad Nacht mitanand."},
    {"id": "qu-abschied-04", "t": "Bis moang."},
    {"id": "qu-abschied-05", "t": "Schlaft's guad!"}
   ]
  },
  {
   "wer": "quirin",
   "lage": "fluss",
   "name": "Vergleicht mit dem Fluss (höchstens einmal je Folge)",
   "bedarf": 12,
   "tage": [2, 3, 4, 7],
   "s": [
    {"id": "qu-fluss-01", "t": "Bei uns aufm Main …"},
    {"id": "qu-fluss-02", "t": "Auf da Donau war des so:"},
    {"id": "qu-fluss-03", "t": "Dahoam auf'm Kanal …"},
    {"id": "qu-fluss-04", "t": "Bei uns gibt's sowas ned."},
    {"id": "qu-fluss-05", "t": "Auf'm Fluss is des anders, ganz anders."},
    {"id": "qu-fluss-06", "t": "Wenn i des meim Vadda erzähl …"}
   ]
  },
  {
   "wer": "quirin",
   "lage": "erkennung",
   "name": "Erkennungssätze",
   "klein": true,
   "tage": [2, 3, 4, 7],
   "s": [
    {"id": "qu-erkennung-01", "t": "Mir is ganz bliamerant.", "b": 3, "e": true},
    {"id": "qu-erkennung-02", "t": "Hinni!", "b": 4, "e": true, "hinweis": "Hinnerk antwortet mit „Mit zwei n und ohne i.“"}
   ]
  },
  {
   "wer": "klabauter",
   "lage": "warnen",
   "name": "Warnen",
   "bedarf": 14,
   "s": [
    {"id": "kl-warnen-01", "t": "Wahrschau! Wahrschau!", "b": 2},
    {"id": "kl-warnen-02", "t": "Grund! Grund!", "b": 2},
    {"id": "kl-warnen-03", "t": "Dicker Pott! Dicker Pott!", "b": 2},
    {"id": "kl-warnen-04", "t": "Nebel! Nebel!", "b": 2},
    {"id": "kl-warnen-05", "t": "Blaulicht! Blaulicht!", "b": 2},
    {"id": "kl-warnen-06", "t": "Achtung! Achtung!", "b": 2},
    {"id": "kl-warnen-07", "t": "Zu schnell! Zu schnell!", "b": 2},
    {"id": "kl-warnen-08", "t": "Leine! Leine!", "b": 2}
   ]
  },
  {
   "wer": "klabauter",
   "lage": "petzen",
   "name": "Petzen",
   "bedarf": 8,
   "s": [
    {"id": "kl-petzen-01", "t": "Gesehen! Gesehen!", "b": 2},
    {"id": "kl-petzen-02", "t": "Falsch rum! Falsch rum!", "b": 2},
    {"id": "kl-petzen-03", "t": "Nicht gemerkt! Nicht gemerkt!", "b": 2},
    {"id": "kl-petzen-04", "t": "Gemogelt! Gemogelt!", "b": 2},
    {"id": "kl-petzen-05", "t": "Geraten! Geraten!", "b": 2}
   ]
  },
  {
   "wer": "klabauter",
   "lage": "feiern",
   "name": "Feiern",
   "bedarf": 12,
   "s": [
    {"id": "kl-feiern-01", "t": "Darf! Darf!", "b": 2},
    {"id": "kl-feiern-02", "t": "Kann's! Kann's!", "b": 2},
    {"id": "kl-feiern-03", "t": "Land in Sicht! Land in Sicht!", "b": 2},
    {"id": "kl-feiern-04", "t": "Hurra! Zwieback!", "b": 2},
    {"id": "kl-feiern-05", "t": "Richtig! Richtig!", "b": 2},
    {"id": "kl-feiern-06", "t": "Bravo! Bravo!", "b": 2}
   ]
  },
  {
   "wer": "klabauter",
   "lage": "betteln",
   "name": "Betteln",
   "bedarf": 6,
   "s": [
    {"id": "kl-betteln-01", "t": "Hunger! Hunger!", "b": 2},
    {"id": "kl-betteln-02", "t": "Krabben! Krabben!", "b": 2},
    {"id": "kl-betteln-03", "t": "Kekse! Kekse!", "b": 2},
    {"id": "kl-betteln-04", "t": "Futter! Futter!", "b": 2},
    {"id": "kl-betteln-05", "t": "Leckerli! Leckerli!", "b": 2}
   ]
  },
  {
   "wer": "klabauter",
   "lage": "wetter",
   "name": "Seewetterbericht nachplappern",
   "bedarf": 6,
   "s": [
    {"id": "kl-wetter-01", "t": "West fünf bis sechs! Böen!", "b": 1},
    {"id": "kl-wetter-02", "t": "Abnehmend! Abnehmend!", "b": 1},
    {"id": "kl-wetter-03", "t": "Sicht gut! Sicht gut!", "b": 1},
    {"id": "kl-wetter-04", "t": "Zunehmend! Zunehmend!", "b": 1},
    {"id": "kl-wetter-05", "t": "Drehend! Drehend!", "b": 1},
    {"id": "kl-wetter-06", "t": "Schauerböen! Schauerböen!", "b": 1}
   ]
  },
  {
   "wer": "klabauter",
   "lage": "nachplappern",
   "name": "Plappert die Crew nach",
   "bedarf": 10,
   "s": [
    {"id": "kl-nachplappern-01", "t": "Sabbel nich! Sabbel nich!", "b": 2},
    {"id": "kl-nachplappern-02", "t": "Nee, Käpt'n! Nee, Käpt'n!", "b": 2},
    {"id": "kl-nachplappern-03", "t": "Obacht! Obacht!", "b": 2},
    {"id": "kl-nachplappern-04", "t": "Geht. Geht.", "b": 2},
    {"id": "kl-nachplappern-05", "t": "Kiek mol! Kiek mol!", "b": 2},
    {"id": "kl-nachplappern-06", "t": "Finger weg! Finger weg!", "b": 2}
   ]
  },
  {
   "wer": "klabauter",
   "lage": "ruf",
   "name": "Ruf und Antwort (Rahmen fürs Merkwort)",
   "bedarf": 20,
   "s": [
    {"id": "kl-ruf-01", "t": "Wie viel? Wie viel?"},
    {"id": "kl-ruf-02", "t": "Welche Seite? Welche Seite?"},
    {"id": "kl-ruf-03", "t": "Wer muss? Wer muss?"},
    {"id": "kl-ruf-04", "t": "Wie oft? Wie oft?"},
    {"id": "kl-ruf-05", "t": "Welche Farbe? Welche Farbe?"},
    {"id": "kl-ruf-06", "t": "Was jetzt? Was jetzt?"},
    {"id": "kl-ruf-07", "t": "Merken! Merken!"},
    {"id": "kl-ruf-08", "t": "Nochmal! Nochmal!"}
   ]
  },
  {
   "wer": "klabauter",
   "lage": "sonst",
   "name": "Unglück, Müdigkeit, Rückkehr",
   "bedarf": 6,
   "klein": true,
   "s": [
    {"id": "kl-sonst-01", "t": "Freitag! Freitag!", "b": 1},
    {"id": "kl-sonst-02", "t": "Pfeifen! Nicht pfeifen!", "b": 1},
    {"id": "kl-sonst-03", "t": "Koje! Koje!", "b": 1},
    {"id": "kl-sonst-04", "t": "Müde! Müde!", "b": 1},
    {"id": "kl-sonst-05", "t": "Wieder da! Wieder da!", "b": 1, "hinweis": "nur 1-6"},
    {"id": "kl-sonst-06", "t": "Vermisst? Vermisst?", "b": 1, "hinweis": "nur 1-6"}
   ]
  },
  {
   "wer": "klabauter",
   "lage": "erkennung",
   "name": "Erkennungssätze",
   "klein": true,
   "s": [
