   "lage": "abend",
   "name": "Abend und Abschied",
   "bedarf": 21,
   "s": [
    {"id": "hi-abend-01", "t": "Gode Nacht."},
    {"id": "hi-abend-02", "t": "Hol di fuchtig."},
    {"id": "hi-abend-03", "t": "Licht aus, Ohren zu."},
    {"id": "hi-abend-04", "t": "Morgen früh. Nich zu früh."},
    {"id": "hi-abend-05", "t": "Schlaf gut. Ich … mach noch die Lampen."},
    {"id": "hi-abend-06", "t": "Koje. Jetzt."},
    {"id": "hi-abend-07", "t": "Morgen wird's ernst. Heute nich mehr."},
    {"id": "hi-abend-08", "t": "Ich guck noch nach den Leinen. Wie immer."},
    {"id": "hi-abend-09", "t": "Na dann. Bis morgen."},
    {"id": "hi-abend-10", "t": "Wer schnarcht, schläft an Deck."}
   ]
  },
  {
